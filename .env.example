# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AA...
# Bot username without @
BOT_USERNAME=skywalk_game_bot
# Mini App short name created with /newapp in @BotFather (t.me/<BOT_USERNAME>/<APP_SHORT_NAME>)
APP_SHORT_NAME=skywalk
# Random string (A-Z a-z 0-9 _ -) sent by Telegram in X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Public https URL of the deployed app (defaults to VERCEL_PROJECT_PRODUCTION_URL on Vercel)
APP_URL=https://your-app.vercel.app

# Upstash Redis (added automatically by the Vercel Marketplace integration)
KV_REST_API_URL=https://xxxx.upstash.io
KV_REST_API_TOKEN=xxxx

# Optional: separate signing key for round tokens and launch payloads (defaults to a key derived from BOT_TOKEN)
GAME_SECRET=
# Optional: max age of Telegram initData in seconds (default 86400)
INITDATA_MAX_AGE_SEC=86400
# Optional: allow guest play outside Telegram in production (always allowed in development; guests are never ranked)
ALLOW_GUEST=false
